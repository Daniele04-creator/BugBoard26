@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
actor "Amministratore\nADMIN" as Admin
actor "Membro del team\nMEMBER" as Member
actor "Stakeholder\nVIEWER" as Viewer
rectangle "BugBoard26 — lavoro collaborativo" {
  usecase "UC-02 / RF-02\nSegnalare una issue" as U02
  usecase "UC-03 / RF-03\nConsultare e filtrare issue" as U03
  usecase "UC-04 / RF-04\nAssegnare e consultare il lavoro" as U04
  usecase "UC-05 / RF-05\nCommentare una issue" as U05
  usecase "UC-06 / RF-06\nGestire stato e risoluzione" as U06
  usecase "UC-08 / RF-08\nEsportare l'elenco CSV" as U08
  usecase "UC-10 / RF-10\nGestire e associare etichette" as U10
  usecase "UC-11 / RF-11\nCercare issue" as U11
  usecase "UC-12 / RF-12\nConsultare la cronologia" as U12
}
Admin --> U02
Member --> U02
Admin --> U03
Member --> U03
Viewer --> U03
Admin --> U04
Member --> U04
Admin --> U05
Member --> U05
Admin --> U06
Member --> U06
Admin --> U08
Member --> U08
Viewer --> U08
Admin --> U10
Member --> U10
Admin --> U11
Member --> U11
Viewer --> U11
Admin --> U12
Member --> U12
Viewer --> U12
note right of U04
  Solo ADMIN assegna.
  ADMIN/MEMBER consultano il proprio lavoro.
end note
note right of U06
  MEMBER cambia stato solo se assegnatario.
end note
note right of U10
  Solo ADMIN gestisce il catalogo.
  MEMBER associa solo su issue assegnate.
end note
@enduml
