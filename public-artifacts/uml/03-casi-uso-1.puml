@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
actor "Amministratore\nADMIN" as Admin
actor "Membro del team\nMEMBER" as Member
actor "Stakeholder\nVIEWER" as Viewer
rectangle "BugBoard26 — identità e autorizzazioni" {
  usecase "UC-01 / RF-01\nAutenticarsi" as U01
  usecase "UC-09 / RF-09\nModificare una issue" as U09
  usecase "UC-15 / RF-15\nConsultare in sola lettura" as U15
  usecase "UC-19 / RF-01, RF-15\nGestire account e credenziali" as U19
}
Admin --> U01
Member --> U01
Viewer --> U01
Admin --> U09
Member --> U09
Viewer --> U15
Admin --> U19
Member --> U19
Viewer --> U19
note right of U09
  MEMBER modifica solo issue assegnate.
  Tutti rispettano lo stato modificabile.
end note
note right of U19
  Solo ADMIN crea/gestisce account altrui.
  Tutti gestiscono il proprio nome/password.
end note
@enduml
